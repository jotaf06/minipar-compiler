# Saida e conversoes no formato do Python

seq {
    # Numeros reais e logicos como no print do Python
    print(2.0, 0.1 + 0.2, 1 / 3, 0.00001, 7 / 2, 10 // 4);
    print(3 > 2, 1 == 2, [1.5, 2.0], ["a", "b"]);

    # str(), format() com casas decimais e to_int()
    var tempo = 3.14159;
    print("Tempo Sequencial : " + format(tempo, 2) + " s");
    print("Reducao: " + format(15.5432, 1) + "%");
    print("str:", str(42) + str(2.5) + str(true));
    print("to_int:", to_int(3.99), to_int(-3.99), to_int("123") + 1);
    print("to_number:", to_number("2.5") * 2);

    # Caractere escolhido por indice calculado (fractal do teste 9)
    var caracteres = " .:-=+#%@";
    var iteracao = 50;
    var max_iter = 100;
    var idx = to_int((iteracao / max_iter) * (len(caracteres) - 1));
    print("char_idx:", idx, "char:", caracteres[idx]);

    # clock(): mede um intervalo de tempo
    var inicio = clock();
    var soma = 0;
    var i = 0;
    while (i < 1000000) {
        soma = (soma * 31 + i) % 1000003;
        i = i + 1;
    }
    var duracao = clock() - inicio;
    print("clock ok:", duracao >= 0, "| soma:", soma);
}
